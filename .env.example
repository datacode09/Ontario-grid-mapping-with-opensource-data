# ============================================================
# Ontario Grid Mapper — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# ============================================================

# --- Google Street View Static API ---
# Required for GridMapping ML inference (Source 16)
# Free tier: 28,000 images/month
# Obtain at: https://developers.google.com/maps/documentation/streetview/
GOOGLE_STREETVIEW_API_KEY=your_google_streetview_api_key_here

# --- Mapillary API (open alternative to Google Street View) ---
# Fully open, no cost, less dense coverage in suburban Ontario
# Register at: https://www.mapillary.com/developer
MAPILLARY_CLIENT_TOKEN=your_mapillary_client_token_here

# --- Google Earth Engine ---
# Required for GEE SAR processing path (Source 23)
# Free registration: https://signup.earthengine.google.com/
# After registering, run: earthengine authenticate
GEE_PROJECT_ID=your_gee_project_id_here
GEE_SERVICE_ACCOUNT=your_service_account@your_project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=config/gee_private_key.json

# --- Copernicus Data Space Ecosystem (CDSE) ---
# Required for Sentinel-1 downloads via CDSE fallback (Source 20)
# Free registration: https://dataspace.copernicus.eu/
CDSE_USERNAME=your_cdse_username_here
CDSE_PASSWORD=your_cdse_password_here

# --- ASF DAAC (Alaska Satellite Facility) ---
# Required for Sentinel-1 RTC downloads (Source 21)
# Free registration: https://search.asf.alaska.edu/
# Uses NASA Earthdata credentials
ASF_USERNAME=your_earthdata_username_here
ASF_PASSWORD=your_earthdata_password_here

# --- Statistics Canada API ---
# Optional: for programmatic census data access
STATCAN_API_KEY=your_statcan_api_key_here

# --- Pipeline Configuration Overrides ---
# Uncomment to override settings.yaml values at runtime
# SAR_ENABLED=false
# LOG_LEVEL=DEBUG
# CACHE_MAX_AGE_DAYS=7
# REGION=Mississauga
